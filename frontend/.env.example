# ============================================================================
# Sentinel frontend — Vite dev-server proxy targets
#
# Copy this file to `frontend/.env` before `npm run dev`. These vars
# are read at vite startup and never reach the browser bundle.
# ============================================================================

# Pick the mode that matches how you're running the backend:
#
# 1) Docker stack (README quickstart: `docker compose up -d`).
#    Everything is fronted by NGINX on host port 80; uncomment this
#    block and comment out the host-side block below.
#
# VITE_RDA_URL=http://localhost
# VITE_FIA_URL=http://localhost/fia
# VITE_MLA_URL=http://localhost/mla   # only if you also run MLA behind nginx
#
# 2) Host-side dev — `npm run start:dev` from the repo root, plus
#    `python -m src.main` from mla-service / fia-service. Each runs on
#    its own port. This is the default below.
#
VITE_RDA_URL=http://127.0.0.1:3000
VITE_FIA_URL=http://127.0.0.1:9094
VITE_MLA_URL=http://127.0.0.1:9095
