# ===========================================
# PAA Worker Service Configuration
# Copy this file to .env and update values
# ===========================================

# Application
NODE_ENV=development
APP_NAME=paa-service
LOG_LEVEL=info
METRICS_PORT=9090

# Database
DB_CLIENT=pg
DB_URL=postgresql://postgres:postgres@localhost:5432/fraud_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=transactions.completed
KAFKA_CONSUMER_GROUP=pattern-analysis
KAFKA_CLIENT_ID=paa-service

# PAA Configuration
GRAPH_UPDATE_INTERVAL=300000
PAGERANK_DAMPING=0.85
BATCH_SIZE=100
MAX_GRAPH_NODES=1000000
