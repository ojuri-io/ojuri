# ═══════════════════════════════════════════════════════════════════════════
# MLA SERVICE CONFIGURATION
# Copy this to .env and update values for your environment
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# Kafka Configuration
# ───────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=model-learning
KAFKA_TOPIC=transactions.completed

# ───────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ───────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fraud_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ───────────────────────────────────────────────────────────────────────────
# Drift Detection Thresholds
# ───────────────────────────────────────────────────────────────────────────
# F1-score threshold: Retrain if F1 drops below this (0.90-0.95 recommended)
DRIFT_F1_THRESHOLD=0.92

# PSI threshold: Retrain if PSI exceeds this (0.20-0.30 recommended)
DRIFT_PSI_THRESHOLD=0.25

# Sliding window size for drift monitoring (transactions)
DRIFT_WINDOW_SIZE=1000

# ───────────────────────────────────────────────────────────────────────────
# Training Configuration
# ───────────────────────────────────────────────────────────────────────────
# Number of recent labeled transactions to use for training
# RECOMMENDED SETTINGS:
#   Development/Testing: 10000-50000  (fast, low RAM)
#   Staging:             50000-100000 (balanced)
#   Production:          500000+      (best quality, high RAM)
TRAINING_DATA_SIZE=50000

# SMOTE ratio for class balancing (1.0 = 50-50 balance)
SMOTE_RATIO=1.0

# Cross-validation folds (3-10 recommended)
CV_FOLDS=5

# ───────────────────────────────────────────────────────────────────────────
# XGBoost Hyperparameters
# ───────────────────────────────────────────────────────────────────────────
XGBOOST_N_ESTIMATORS=150
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_SUBSAMPLE=0.8
XGBOOST_COLSAMPLE_BYTREE=0.8

# ───────────────────────────────────────────────────────────────────────────
# Model Registry (filesystem-only in this distribution)
# ───────────────────────────────────────────────────────────────────────────
# Trained models are written under `mla-service/models/versions/<version>/`
# and that directory IS the registry. There is no S3/MinIO in this build;
# deploy a new model to RDA by copying the `.onnx` into the root `models/`
# directory (see docs/TRAINING.md).
MODEL_OUTPUT_DIR=./models
DATA_CACHE_DIR=./data

# ───────────────────────────────────────────────────────────────────────────
# RDA Bridge — auto-registers and auto-activates new model versions
# ───────────────────────────────────────────────────────────────────────────
# When both are set, every model MLA trains is POSTed to RDA's admin API
# (`POST /v1/admin/models` to register) and — for drift- or initial-
# triggered retrains — promoted to ACTIVE via `POST /v1/admin/models/<v>/status`.
# Manual (UI-triggered) retrains skip the activate step so the operator
# can inspect metrics in Sentinel before promoting.
#
# `MLA_SERVICE_TOKEN` is a shared secret (NOT a JWT) — RDA accepts it as
# a bearer token via the service-token path in `requireAuth`, synthesises
# a `service:mla` subject scoped to the three model permissions
# (read, register, set_status), and rejects it for anything else.
# Long-running MLA processes don't need to refresh.
#
# IMPORTANT: this value MUST match the one you set in the repo-root
# `.env` (which RDA reads). Mismatches produce 401s on every retrain
# attempt and the warnings below.
#
# Leave both unset and MLA falls back to local-only mode — versions
# land under `models/versions/<v>/` and an operator must click Activate
# in Sentinel for every retrain.
#
# Pick ONE RDA_API_URL line based on how RDA is running:
#   - Docker-stack quickstart (NGINX fronts RDA on :80) → http://localhost
#   - Host-side RDA (`npm run start:dev` from repo root)   → http://localhost:3000
# The default below assumes the README quickstart (docker compose).
RDA_API_URL=http://localhost
# RDA_API_URL=http://localhost:3000
MLA_SERVICE_TOKEN=dev-only-mla-service-token-change-in-prod-please-rotate-min-32-chars

# ───────────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
