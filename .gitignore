# Dependency directories
node_modules
jspm_packages

# Optional yarn cache directory
.yarn

# Coverage directory used by tools like istanbul
coverage

# mac files
.DS_Store

# webstorm
.idea

# vscode
.vscode
*code-workspace

# compiled app
dist

*.key
.env

# Python virtual environments and caches (FIA / MLA / PAA)
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/

# Runtime LevelDB Kafka buffer (RDA disk fallback)
.kafka-buffer/

# Local tool / IDE state
.claude/
.qodo/

# Trained model artefacts — produced by `mla-service/scripts/train_initial_model.py`
# and reproducible from training data. Source is the catalogue + scripts, not the
# binary weights. Keep `models/feature-catalog.*.json` and `models/lookups/`.
models/current_production_model.*
models/fraud_model.onnx
models/fraud_model_*.onnx
models/fraud_model_*_scaler.npz
models/fraud_model_*.json
models/versions/

# Logs
*.log

# Test coverage
.nyc_output/
htmlcov/

# Build outputs
build/

# OS / editor cruft
Thumbs.db
*.swp
*.swo

# Validation / load-test artefacts. `scripts/fraud-validation-load-test.ts`
# defaults `--out` to `reports/...`; that output is per-run debugging
# data, not source of truth. Re-generate locally when needed.
reports/
data/training-uploads/chunks/
data/training-uploads/*.csv

# Terraform (deploy/aws). State files hold every generated secret in plaintext —
# they must never be committed. The provider lock file is intentionally tracked.
**/.terraform/
**/.terraform-build/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# The sandbox config is hostname + flags with no secrets in it — every
# credential this deployment uses is generated into SSM — so it is tracked,
# and a maintainer can reproduce the environment without reconstructing it.
!deploy/aws/terraform/terraform.tfvars
crash.log

# Rendered by `ojuri render`. Generated from ojuri.yaml on every run, so
# it is never the source of truth and never worth committing.
.ojuri/
