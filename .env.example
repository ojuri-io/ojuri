# ============================================================================
# Ojuri — environment configuration
# Copy this file to .env and adjust values for your environment.
# Quick start: `cp .env.example .env` then `docker compose up -d` then
# `npm install && npm run db:migrate`.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Ojuri
LOG_LEVEL=info
# Display name in the Sentinel dashboard chrome. Leave unset to use APP_NAME.
# BRAND_NAME=Ojuri

# ----------------------------------------------------------------------------
# Database (Postgres in Docker exposes 5433 to the host; in-container is 5432)
# ----------------------------------------------------------------------------
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=fraud_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=postgresql://postgres:postgres@localhost:5433/fraud_db

# Optional read-replica (falls back to primary if unset)
# REPLICA_DB_HOST=
# REPLICA_DB_PORT=
# REPLICA_DB_DATABASE=
# REPLICA_DB_USERNAME=
# REPLICA_DB_PASSWORD=

# ----------------------------------------------------------------------------
# Redis (Redis in Docker exposes 6380 to the host; in-container is 6379)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_POOL_SIZE=50
REDIS_FEATURE_TIMEOUT=10

# ----------------------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=transactions.completed
KAFKA_BLOCKED_TOPIC=transactions.blocked
KAFKA_CONSUMER_GROUP=pattern-analysis
KAFKA_CLIENT_ID=ojuri-rda

# ----------------------------------------------------------------------------
# ONNX model
# ----------------------------------------------------------------------------
MODEL_PATH=./models/fraud_model.onnx
MODEL_POLL_INTERVAL=300000
FRAUD_THRESHOLD=0.65
# Override the model_version string returned in PredictResponseDto when
# no version is registered in the model registry. Useful for tagging
# experimental builds. Falls back to "default" when both this and the
# registry's active champion are unset.
# MODEL_VERSION_LABEL=
# Pad RDA's 64-dim catalogue vector out to a wider input before inference.
# Only useful during the brief window where a model trained against a
# larger feature set is still deployed alongside the new 64-dim pipeline.
# Leave unset (0) once your deployed model is on the v1 catalogue.
# MODEL_INPUT_DIMENSION=64

# ----------------------------------------------------------------------------
# Feature catalogue (see docs/FEATURES.md). Adopters extending the base
# catalogue point ADOPTER_PATH at their overlay file; the LOOKUP_ROOT
# is where any `from_redis` lookup tables live on disk.
# ----------------------------------------------------------------------------
# FEATURE_CATALOG_BASE_PATH=./models/feature-catalog.v1.json
# FEATURE_CATALOG_ADOPTER_PATH=./models/feature-catalog.adopter.json
# FEATURE_LOOKUP_ROOT=./models/lookups

# ----------------------------------------------------------------------------
# Health probes — RDA's /v1/admin/health page fans out to each service's
# /readyz with this per-target timeout. Defaults are sensible for the
# "RDA on host, rest in docker-compose" mix (the most common dev layout);
# raise the timeout for high-latency networks.
#
# PAA's container listens on 9090 but docker-compose maps it to host port
# 9091 — that's why the example below uses 9091, not 9090. If you run PAA
# natively on the host without the mapping (`cd paa-service && npm run
# start:dev`), override to http://localhost:9090.
# ----------------------------------------------------------------------------
# HEALTH_PROBE_TIMEOUT_MS=1000
# RDA_HEALTH_URL=http://localhost:3000
# PAA_HEALTH_URL=http://localhost:9091
# FIA_HEALTH_URL=http://localhost:9094
# MLA_HEALTH_URL=http://localhost:9095

# ----------------------------------------------------------------------------
# Circuit breakers
# ----------------------------------------------------------------------------
CB_REDIS_TIMEOUT=10
CB_REDIS_ERROR_THRESHOLD=50
CB_REDIS_RESET_TIMEOUT=30000
CB_ONNX_TIMEOUT=100
CB_ONNX_ERROR_THRESHOLD=10
CB_ONNX_RESET_TIMEOUT=60000

# ----------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------
# JWT signing secret. RDA refuses to boot in production with this default.
# Generate one with `openssl rand -base64 48` (or similar).
AUTH_JWT_SECRET=dev-only-secret-change-in-prod-please-rotate-min-32-chars
AUTH_JWT_TTL_SECONDS=28800

# Optional pinned claims (recommended in production)
AUTH_JWT_ISSUER=ojuri
AUTH_JWT_AUDIENCE=sentinel

# If true, /v1/predict requires X-Api-Key. Default false for first-touch
# friendliness. Production deployments should set this to true.
RDA_REQUIRE_API_KEY=false

# Shared secret for service-to-service auth from MLA → RDA admin API.
# When set, MLA presents this as `Authorization: Bearer <token>` to
# register new model versions and flip them to ACTIVE without holding a
# rotating user JWT. The token authorises only the three model
# permissions (read, register, set_status) — not full admin. Must be
# ≥32 chars; generate one with `openssl rand -base64 36`. Leave unset
# to disable the bridge — MLA falls back to local-only mode and an
# operator must click Activate in Sentinel for every retrain.
MLA_SERVICE_TOKEN=dev-only-mla-service-token-change-in-prod-please-rotate-min-32-chars

# Per-IP rate limit on /v1/auth/login (requests per minute).
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20

# ----------------------------------------------------------------------------
# CORS — comma-separated origin allowlist
# Dev default: Sentinel dev server + local API. Override in production with
# your dashboard's public origin(s), e.g. "https://sentinel.example.com".
# ----------------------------------------------------------------------------
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# Rules, model registry, webhooks, idempotency
# ----------------------------------------------------------------------------
RULES_RELOAD_INTERVAL_MS=30000
MODEL_REGISTRY_REFRESH_MS=30000
WEBHOOK_WORKER_INTERVAL_MS=10000

# Idempotency cache (Redis-backed). See docs/IDEMPOTENCY.md.
IDEMPOTENCY_TTL_MS=86400000
# Optional gzip of stored responses — ~40–60% size reduction on
# typical PredictResponse payloads. Recommended at >100 req/s.
IDEMPOTENCY_COMPRESS=false
# Per-tenant cardinality cap. Oldest entries are evicted lazily
# when a tenant exceeds this. Stops a noisy tenant from filling
# the cache for everyone.
IDEMPOTENCY_MAX_KEYS_PER_TENANT=10000

# ----------------------------------------------------------------------------
# PAA tuning (only relevant when running PAA on the host)
# ----------------------------------------------------------------------------
GRAPH_UPDATE_INTERVAL=300000
PAGERANK_DAMPING=0.85
BATCH_SIZE=100
MAX_GRAPH_NODES=1000000
HISTORICAL_LOAD_LIMIT=100000

# ----------------------------------------------------------------------------
# Docker Compose overrides (consumed by docker-compose.yml)
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_db
GRAFANA_USER=admin
# Change before exposing Grafana to anything beyond localhost.
GRAFANA_PASSWORD=admin
