KAFKA_BROKERS=localhost:9092
KAFKA_BLOCKED_TOPIC=transactions.blocked
KAFKA_CONSUMER_GROUP=fraud-investigation
KAFKA_AUTO_OFFSET_RESET=earliest

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fraud_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

LLM_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct
LLM_MODEL_PATH=
LLM_DEVICE=auto
LLM_MAX_NEW_TOKENS=384
LLM_TEMPERATURE=0.2
LLM_DTYPE=auto

PROMPT_TEMPLATE_VERSION=v1
FIA_FALLBACK_ON_LLM_FAILURE=true

# Skip the Phi-3 load entirely and serve every report from the
# deterministic rule-based generator. Avoids the ~15 GB resident
# memory hit of loading the model — useful for demos, CI, and any
# host whose Docker Desktop VM is capped below ~18 GB. The pipeline
# still produces parseable rows; only the narrative quality differs.
FIA_DISABLE_LLM=false

METRICS_PORT=9094
LOG_LEVEL=INFO

# HTTP auth — every /v1/reports* and /stats route requires a Bearer JWT
# minted by RDA's POST /v1/auth/login. Must match the RDA AUTH_JWT_SECRET.
AUTH_JWT_SECRET=dev-only-secret-change-in-prod-please-rotate-min-32-chars
# Optional pinned claims (defence-in-depth, off by default).
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Bind address for the HTTP server. Default is loopback so a fresh
# host-side deployment is not reachable from the network without an
# explicit opt-in. Compose flips this to 0.0.0.0 because the container
# loopback is isolated from the host anyway.
FIA_HTTP_BIND=127.0.0.1
