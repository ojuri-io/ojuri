# Trained model artefacts — produced by `mla-service/scripts/train_initial_model.py`
# and reproducible from training data. Source is the catalogue + scripts, not the
# binary weights. Keep `models/feature-catalog.*.json` and `models/lookups/`.
models/current_production_model.*
models/fraud_model.onnx
models/fraud_model_*.onnx
models/fraud_model_*_scaler.npz
models/fraud_model_*.json
models/versions/

# Logs
*.log

# Test coverage
.nyc_output/
htmlcov/

# Build outputs
build/

# OS / editor cruft
Thumbs.db
*.swp
*.swo

# Validation / load-test artefacts. `scripts/fraud-validation-load-test.ts`
# defaults `--out` to `reports/...`; that output is per-run debugging
# data, not source of truth. Re-generate locally when needed.
reports/
data/training-uploads/chunks/
data/training-uploads/*.csv
