# ═══════════════════════════════════════════════════════════════════════════
# MLA SERVICE CONFIGURATION
# Copy this to .env and update values for your environment
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# Kafka Configuration
# ───────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=model-learning
KAFKA_TOPIC=transactions.completed

# ───────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ───────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fraud_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ───────────────────────────────────────────────────────────────────────────
# Drift Detection Thresholds
# ───────────────────────────────────────────────────────────────────────────
# F1-score threshold: Retrain if F1 drops below this (0.90-0.95 recommended)
DRIFT_F1_THRESHOLD=0.92

# PSI threshold: Retrain if PSI exceeds this (0.20-0.30 recommended)
DRIFT_PSI_THRESHOLD=0.25

# Sliding window size for drift monitoring (transactions)
DRIFT_WINDOW_SIZE=1000

# ───────────────────────────────────────────────────────────────────────────
# Training Configuration
# ───────────────────────────────────────────────────────────────────────────
# Number of recent labeled transactions to use for training
# RECOMMENDED SETTINGS:
#   Development/Testing: 10000-50000  (fast, low RAM)
#   Staging:             50000-100000 (balanced)
#   Production:          500000+      (best quality, high RAM)
TRAINING_DATA_SIZE=50000

# SMOTE ratio for class balancing (1.0 = 50-50 balance)
SMOTE_RATIO=1.0

# Cross-validation folds (3-10 recommended)
CV_FOLDS=5

# ───────────────────────────────────────────────────────────────────────────
# XGBoost Hyperparameters
# ───────────────────────────────────────────────────────────────────────────
XGBOOST_N_ESTIMATORS=150
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_SUBSAMPLE=0.8
XGBOOST_COLSAMPLE_BYTREE=0.8

# ───────────────────────────────────────────────────────────────────────────
# MinIO Model Registry
# ───────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fraud-models
MINIO_SECURE=false

# ───────────────────────────────────────────────────────────────────────────
# Paths
# ───────────────────────────────────────────────────────────────────────────
MODEL_OUTPUT_DIR=./models
DATA_CACHE_DIR=./data

# ───────────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
