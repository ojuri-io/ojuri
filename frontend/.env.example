# Proxy targets for the Vite dev server.
# Copy this file to .env and adjust if your services run on non-default ports.
# These are not exposed to the browser — they only affect the dev-server proxy.
VITE_RDA_URL=http://127.0.0.1:3000
VITE_FIA_URL=http://127.0.0.1:9094
VITE_MLA_URL=http://127.0.0.1:9095
