# ===========================================
# Fraud Detection Service Configuration
# Copy this file to .env and update values
# ===========================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=fraud-service
BRAND_NAME=FraudDetect
LOG_LEVEL=info

# Database
DB_CLIENT=pg
DB_URL=postgresql://postgres:postgres@localhost:5432/fraud_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POOL_SIZE=50
REDIS_FEATURE_TIMEOUT=10

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=transactions.completed
KAFKA_CONSUMER_GROUP=pattern-analysis
KAFKA_CLIENT_ID=fraud-service

# ONNX Model
MODEL_PATH=./models/fraud_model.onnx
MODEL_REGISTRY_URL=
MODEL_POLL_INTERVAL=300000

# Fraud Detection
FRAUD_THRESHOLD=0.65

# Circuit Breaker - Redis
CB_REDIS_TIMEOUT=10
CB_REDIS_ERROR_THRESHOLD=50
CB_REDIS_RESET_TIMEOUT=30000

# Circuit Breaker - ONNX
CB_ONNX_TIMEOUT=100
CB_ONNX_ERROR_THRESHOLD=10
CB_ONNX_RESET_TIMEOUT=60000

# PAA Configuration
GRAPH_UPDATE_INTERVAL=300000
PAGERANK_DAMPING=0.85
BATCH_SIZE=100
MAX_GRAPH_NODES=1000000

# Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_db
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
